# ==============================================================================
# ECHOES Environment Configuration (.env.example)
# Digital Memory Vault and Personal Time Capsule
#
# Copy this file to .env.local for local development.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application URL
APP_URL=http://localhost:3000

# Database Configuration
# Local development MongoDB Community Server connection string
MONGODB_URI=mongodb://127.0.0.1:27017/echoes

# Authentication & Security (jose / JWT)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_hs256
JWT_EXPIRES_IN=7d

# Email Subsystem (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Echoes Vault <no-reply@echoesvault.com>"

# Media Storage Configuration (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional in dev/test (defaults to deterministic secret hash); set in production matching Cloudinary Security Settings
CLOUDINARY_AUTH_TOKEN_KEY=your_cloudinary_hex_token_key_here

# Application Environment
NODE_ENV=development
